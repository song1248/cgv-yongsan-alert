# Local execution only. GitHub Actions uses repository secrets and the built-in GITHUB_TOKEN.
#
# Required only when running locally and you want GitHub Issue notifications:
# GitHub personal access token with Issues write access to the target repo.
GITHUB_TOKEN=

# Optional when running locally outside GitHub Actions.
GITHUB_REPOSITORY=owner/repo

# Optional override. Defaults to watch-config.json.
WATCH_CONFIG=watch-config.json

# Optional override. Defaults to data/state.json.
STATE_FILE=data/state.json

# Optional email notifications through Resend.
RESEND_API_KEY=
EMAIL_FROM=CGV Alert <alerts@example.com>
EMAIL_RECIPIENTS=user1@example.com,user2@example.com
