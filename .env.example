# Copy this file to .env for local execution:
#   cp .env.example .env
#
# Do not commit .env. It contains tokens and email addresses.
#
# GitHub Actions can use repository Variables for EMAIL_PROVIDER, EMAIL_FROM,
# and EMAIL_RECIPIENTS. API keys and app passwords must be repository Secrets
# because GitHub can print Variables in workflow logs.

# Required only when running locally and you want GitHub Issue notifications.
# Use a GitHub personal access token with Issues write access to the target repo.
GITHUB_TOKEN=

# Required for local GitHub Issue notifications.
GITHUB_REPOSITORY=song1248/cgv-yongsan-alert

# Optional override. Defaults to watch-config.json.
WATCH_CONFIG=watch-config.json

# Optional override. Defaults to data/state.json.
STATE_FILE=data/state.json

# Email provider. Use gmail or resend.
EMAIL_PROVIDER=gmail

# Optional Gmail email notifications.
# For local execution these values are read from .env.
# For GitHub Actions register these as repository Secrets, not Variables.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional Resend email notifications.
# For local execution this value is read from .env.
# For GitHub Actions register this as a repository Secret, not a Variable.
# RESEND_API_KEY starts with re_...
RESEND_API_KEY=

# Optional. For Gmail, omit this or set it to the same address as GMAIL_USER.
# Gmail may rewrite From to the authenticated Gmail account.
# For Resend, EMAIL_FROM must use a domain verified in Resend when sending to multiple people.
EMAIL_FROM=

# Comma-separated recipients. The watcher sends one email per recipient.
EMAIL_RECIPIENTS=
